# Built templates: https://github.com/github/gitignore/blob/main/Android.gitignore

# Gradle files
.gradle/
build/
/*/build/
capture/

# Kotlin
.kotlin/

# IDE files
.idea/
*.iml
*.ipr
*.iws
.navigation/

# Local configuration
local.properties

# Log files
*.log

# Keystores & signing (release keys must never be committed)
*.jks
*.keystore
*.p12
*.pepk

# Local Database files (SQLite/Room cache)
*.db
*.db-journal
*.db-shm
*.db-wal
music_database.db

# OS-specific files
.DS_Store
Thumbs.db

# Temporary / test scrap files
cobalt_html.txt
temp_inspect/
local_app_debug_logs.txt
local_app_debug_logs_utf8.txt
